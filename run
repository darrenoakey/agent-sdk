#!/usr/bin/env python3
# run — pure bootstrap facade. No logic here. Everything delegates to src/main.py.
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).parent.resolve()
VENV = SCRIPT_DIR / ".venv"
REQS = SCRIPT_DIR / "requirements.txt"
PYTHON = VENV / "bin" / "python"

if Path(sys.executable).resolve() != PYTHON.resolve():
    if not VENV.exists():
        subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
    if REQS.exists():
        subprocess.run([str(PYTHON), "-m", "pip", "install", "-q", "-r", str(REQS)], check=True)
    os.execv(str(PYTHON), [str(PYTHON), str(Path(__file__).resolve())] + sys.argv[1:])
else:
    # handle install command before importing main (no deps needed)
    if len(sys.argv) > 1 and sys.argv[1] == "install":
        print("Installing daz-agent-sdk as editable package (system-wide)...")
        rc = subprocess.run(
            [sys.executable, "-m", "pip", "install", "-e", str(SCRIPT_DIR)],
            check=False,
        ).returncode
        sys.exit(rc)

    # deploy/publish: bump version, build, upload to PyPI, install globally from PyPI
    if len(sys.argv) > 1 and sys.argv[1] in ("deploy", "publish"):
        import glob
        import json
        import re
        import selectors
        import shutil
        import signal
        import time
        import urllib.error
        import urllib.request

        def pypi_token() -> str:
            # Headless greenline cannot use macOS keyring/security-keyring.
            # daz-secrets is the configured non-interactive credential path.
            command = [
                "/Users/darrenoakey/.local/bin/daz-secrets",
                "get",
                "pypi",
                "api_token",
            ]
            try:
                process = subprocess.Popen(
                    command,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    env={},
                    start_new_session=True,
                )
            except FileNotFoundError as exc:
                print("ERROR: canonical daz-secrets CLI is unavailable")
                raise SystemExit(1) from exc

            def stop_process() -> None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()

            assert process.stdout is not None
            deadline = time.monotonic() + 15
            output = bytearray()
            try:
                with selectors.DefaultSelector() as selector:
                    selector.register(process.stdout, selectors.EVENT_READ)
                    while True:
                        remaining = deadline - time.monotonic()
                        if remaining <= 0 or not selector.select(remaining):
                            stop_process()
                            print("ERROR: daz-secrets get pypi api_token timed out")
                            raise SystemExit(1)
                        chunk = os.read(process.stdout.fileno(), 4097 - len(output))
                        if not chunk:
                            break
                        output.extend(chunk)
                        if len(output) > 4096:
                            stop_process()
                            print("ERROR: PyPI token from daz-secrets exceeds the permitted size")
                            raise SystemExit(1)
                process.wait(timeout=max(0.001, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                stop_process()
                print("ERROR: daz-secrets get pypi api_token timed out")
                raise SystemExit(1)
            if process.returncode != 0:
                print("ERROR: daz-secrets get pypi api_token failed")
                raise SystemExit(1)
            try:
                token = output.decode("utf-8")
            except UnicodeDecodeError as exc:
                print("ERROR: PyPI token from daz-secrets is not UTF-8")
                raise SystemExit(1) from exc
            if not token:
                print("ERROR: empty PyPI token from daz-secrets (service='pypi', account='api_token')")
                raise SystemExit(1)
            return token

        def published_version() -> tuple[int, int, int] | None:
            # The git-committed __init__.py version drifts behind PyPI by
            # design: this script never commits its own bump, so any deploy
            # that runs after a successful one — or after a rollback whose
            # PyPI publish had actually succeeded — recomputes the SAME
            # already-published version from the stale file and gets a 400
            # from twine (observed three times in a row on 2026-08-19).
            # Ask PyPI what is really live and bump from that instead of
            # trusting local git state, so the version number self-heals
            # regardless of git/PyPI drift.
            try:
                with urllib.request.urlopen(
                    "https://pypi.org/pypi/daz-agent-sdk/json", timeout=10
                ) as resp:
                    data = json.load(resp)
            except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
                return None
            releases = data.get("releases", {})
            best: tuple[int, int, int] | None = None
            for raw in releases:
                pm = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", raw)
                if not pm:
                    continue
                candidate = (int(pm.group(1)), int(pm.group(2)), int(pm.group(3)))
                if best is None or candidate > best:
                    best = candidate
            return best

        def release_files(ver: str) -> list[str]:
            # Per-release JSON is authoritative the moment an upload is
            # accepted, unlike the project's top-level "latest" view, which
            # can lag by minutes.
            try:
                with urllib.request.urlopen(
                    f"https://pypi.org/pypi/daz-agent-sdk/{ver}/json", timeout=10
                ) as resp:
                    data = json.load(resp)
            except urllib.error.HTTPError as exc:
                if exc.code == 404:
                    return []
                raise
            return [entry.get("filename", "") for entry in data.get("urls", [])]

        version_file = SCRIPT_DIR / "src" / "daz_agent_sdk" / "__init__.py"
        text = version_file.read_text()
        m = re.search(
            r'^__version__ = ["\'](\d+)\.(\d+)\.(\d+)["\']',
            text,
            re.MULTILINE,
        )
        if not m:
            print("ERROR: version not found in __init__.py")
            sys.exit(1)
        local_ver = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
        pypi_ver = published_version()
        base_ver = max(local_ver, pypi_ver) if pypi_ver is not None else local_ver
        if pypi_ver is not None and pypi_ver > local_ver:
            print(
                f"Local version {'.'.join(map(str, local_ver))} is behind "
                f"PyPI's published {'.'.join(map(str, pypi_ver))}; bumping from PyPI."
            )
        maj, minor, patch = base_ver
        new_ver = f"{maj}.{minor}.{patch + 1}"
        original_text = text
        text = re.sub(
            r'^(__version__ = ["\'])\d+\.\d+\.\d+(["\'])',
            rf"\g<1>{new_ver}\g<2>",
            text,
            flags=re.MULTILINE,
        )
        # Idempotent re-run (greenline re-runs `deploy` as its health probe):
        # when the bumped version is ALREADY on PyPI the publish happened and
        # a second twine upload would be a 400 "file already exists"
        # (observed 2026-09-04: the health re-run of a successful publish
        # failed the whole gate that way). Only build and upload a version
        # PyPI does not have.
        if release_files(new_ver):
            print(f"daz-agent-sdk {new_ver} is already published on PyPI; not re-uploading")
        else:
            # The bump lives only in the built artifacts: deploy runs in the
            # canonical checkout, and a dirty __init__.py there blocks every
            # later greenline submit ("canonical checkout is DIRTY", seen
            # twice on 2026-09-04). PyPI is the version of record.
            version_file.write_text(text)
            print(f"Version bumped to {new_ver}")
            try:
                subprocess.run(
                    [sys.executable, "-m", "pip", "install", "-q", "build", "twine", "setuptools", "wheel"],
                    check=True,
                )
                for d in (SCRIPT_DIR / "dist", SCRIPT_DIR / "build"):
                    if d.exists():
                        shutil.rmtree(d)
                # --no-isolation: `build`'s default creates TWO throwaway venvs
                # (one for the sdist, one for the wheel) and pip-installs
                # setuptools into each — 35s of the release budget for a
                # backend this venv already has pinned above. Building in this
                # interpreter produces the same artifacts in ~10s.
                subprocess.run(
                    [sys.executable, "-m", "build", "--no-isolation"],
                    cwd=str(SCRIPT_DIR),
                    check=True,
                )
            finally:
                version_file.write_text(original_text)

            # upload to PyPI
            token = pypi_token()
            dist_files = glob.glob(str(SCRIPT_DIR / "dist" / "*"))
            from twine.commands import upload as twine_upload
            from twine.settings import Settings

            twine_upload.upload(
                Settings(username="__token__", password=token, non_interactive=True),
                dist_files,
            )
            # PyPI's edge cache serves the pre-upload 404 for this release
            # URL for a while after the upload is accepted (2026-09-04: 0.2.33
            # was live at 23:25:15, still 404 at 23:25:35). Wait, bounded,
            # until PyPI itself lists both files: that is the publish proof,
            # and it also means greenline's health re-run of this script sees
            # the release and does not upload it a second time.
            published: list[str] = []
            for _ in range(20):
                published = release_files(new_ver)
                if len(published) >= 2:
                    break
                time.sleep(5)
            if len(published) < 2:
                print(f"ERROR: twine returned success but PyPI lists {published} for {new_ver} after 100 s")
                sys.exit(1)
            print(f"Published daz-agent-sdk {new_ver} to PyPI: {', '.join(published)}")

        # Install globally. PyPI's simple index can lag the upload by minutes
        # (2026-08-19: >90 s; 2026-09-04: a 10-minute wait budget blew
        # greenline's 3-minute deploy cap and rolled main back AFTER the
        # publish had succeeded). The just-built wheel in dist/ is
        # byte-identical to what PyPI accepted, so let pip take it from
        # --find-links when the index has not caught up yet; dependencies
        # still resolve from the index as usual.
        dist_dir = SCRIPT_DIR / "dist"
        find_links = ["--find-links", str(dist_dir)] if dist_dir.is_dir() else []
        global_python_command = shutil.which("python3")
        if global_python_command is None:
            print("ERROR: global python3 is unavailable")
            sys.exit(1)
        global_python = str(Path(global_python_command).resolve())
        installed = False
        attempts = 6
        for attempt in range(1, attempts + 1):
            result = subprocess.run(
                [
                    global_python,
                    "-m",
                    "pip",
                    "install",
                    "--upgrade",
                    *find_links,
                    f"daz-agent-sdk=={new_ver}",
                ],
                check=False,
            )
            if result.returncode == 0:
                installed = True
                break
            if attempt < attempts:
                print(
                    f"pip could not install {new_ver} yet; retrying in 10 seconds ({attempt}/{attempts})..."
                )
                time.sleep(10)
        if not installed:
            print(f"ERROR: Published daz-agent-sdk {new_ver}, but could not install it")
            sys.exit(1)
        reported = subprocess.check_output(
            [
                global_python,
                "-c",
                "import daz_agent_sdk; print(daz_agent_sdk.__version__)",
            ],
            text=True,
        ).strip()
        if reported != new_ver:
            print(f"ERROR: global daz_agent_sdk reports {reported}, expected {new_ver}")
            sys.exit(1)
        print(f"Installed daz-agent-sdk {new_ver} globally")
        sys.exit(0)

    sys.path.insert(0, str(SCRIPT_DIR / "src"))
    from daz_agent_sdk.main import main
    sys.exit(main())
