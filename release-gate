# ##################################################################
# build phases
# assemble the phase graph for the selected impact areas
def build_phases(areas: set[str], work_root: Path, env: dict[str, str]) -> list[Phase]:
    go_root = PROJECT_ROOT / "go"
    xml_path = work_root / "python-tests.xml"
    healthz_binary = work_root / "igs-healthz.test"
    phases: list[Phase] = []

    if "python" in areas:
        phases.extend(
            [
                Phase("python-dependencies", _command([str(PYTHON_BIN), "-m", "pip", "check"])),
                Phase("python-lint", _command([str(PYTHON_BIN), "-m", "ruff", "check", "src"])),
                Phase(
                    "python-types",
                    _command([str(PYTHON_BIN), "-m", "pyright", "src/daz_agent_sdk"]),
                ),
                Phase(
                    "python-tests",
                    _command(
                        [
                            str(PYTHON_BIN),
                            "-m",
                            "pytest",
                            "-q",
                            "-W",
                            "error",
                            "-rA",
                            "-p",
                            "xdist",
                            "-n",
                            PYTEST_WORKERS,
                            "--dist",
                            "worksteal",
                            "--junitxml",
                            str(xml_path),
                            "-m",
                            "not real_igs and not live",
                            "src",
                        ]
                    ),
                ),
                Phase(
                    "python-tests-outcomes",
                    lambda _log, path=xml_path: validate_pytest_xml(path),
                    needs=("python-tests",),
                ),
            ]
        )

    phases.extend(
        [
            Phase(
                "python-image-route-scan",
                _route_scan(
                    r"Capability\.IMAGE|async def (generate_)?image|def (generate_)?image",
                    "src/daz_agent_sdk/providers",
                    "python provider exposes a callable still-image route",
                ),
            ),
            Phase(
                "go-image-route-scan",
                _route_scan(
                    r"CapabilityImage|func .*Image",
                    "go/provider",
                    "go provider exposes a callable still-image route",
                ),
            ),
            Phase(
                "gate-selftest",
                _command(
                    [str(PYTHON_BIN), "-m", "pytest", "-q", "-W", "error", "tests"]
                ),
            ),
        ]
    )

    if "go" in areas:
        phases.extend(
            [
                Phase(
                    "go-format",
                    _shell('files=$(gofmt -l .); test -z "$files" || { echo "$files"; exit 1; }', cwd=go_root),
                ),
                Phase("go-vet", _command(["go", "vet", "./..."], cwd=go_root, env=env)),
                Phase(
                    "go-tests",
                    _command(
                        ["go", "test", "-json", "-count=1", "-timeout", "60s", "./..."],
                        cwd=go_root,
                        env=env,
                    ),
                ),
                Phase(
                    "go-tests-outcomes",
                    _assert_no_go_skips(work_root / "go-tests.log"),
                    needs=("go-tests",),
                ),
                Phase(
                    "go-live-compile",
                    _command(
                        ["go", "test", "-tags=live", "-run", "^$", "./..."], cwd=go_root, env=env
                    ),
                ),
                Phase(
                    "go-build",
                    _command(
                        ["go", "build", "-o", str(work_root / "agent-sdk"), "./cmd/agent-sdk"],
                        cwd=go_root,
                        env=env,
                    ),
                ),
            ]
        )

    if "image" in areas:
        # Gate canaries prove the live route to the canonical Mac mini image
        # service on this host and natively on the mini itself. Full image
        # generation stays in the live_igs / real_igs suites outside the gate.
        go_env = dict(env)
        go_env.update({"CGO_ENABLED": "0", "GOOS": "darwin", "GOARCH": "amd64"})
        phases.extend(
            [
                Phase(
                    "real-local-go-igs-healthz",
                    _command(
                        [
                            "go",
                            "test",
                            "-tags=live_igs",
                            "-count=1",
                            "-run",
                            "^TestImageServiceNativeTransportLive$",
                            "./capability",
                        ],
                        cwd=go_root,
                        env=env,
                    ),
                ),
                Phase(
                    "go-igs-healthz-binary",
                    _command(
                        [
                            "go",
                            "test",
                            "-c",
                            "-o",
                            str(healthz_binary),
                            "-tags=live_igs",
                            "-count=1",
                            "./capability",
                        ],
                        cwd=go_root,
                        env=go_env,
                    ),
                ),
                Phase(
                    "real-remote-go-igs-healthz",
                    _remote_canary(healthz_binary),
                    needs=("go-igs-healthz-binary",),
                ),
                Phase(
                    "real-local-python-igs-healthz",
                    _command([str(PYTHON_BIN), "-"], stdin_text=PYTHON_IGS_HEALTHZ),
                ),
            ]
        )

    return phases


# ##################################################################
# run phases
# execute the graph concurrently, honouring dependencies, failing fast
def run_phases(phases: Iterable[Phase], work_root: Path) -> Phase | None:
    by_name = {phase.name: phase for phase in phases}
    done: set[str] = set()
    failed: Phase | None = None
    lock = threading.Lock()
    threads: list[threading.Thread] = []

    def worker(phase: Phase) -> None:
        nonlocal failed
        log_path = work_root / f"{phase.name}.log"
        phase.log_path = log_path
        started = time.monotonic()
        try:
            phase.run(log_path)
        except PhaseFailure as failure:
            phase.error = str(failure)
        except Exception as failure:  # noqa: BLE001 - any phase crash is a gate failure
            phase.error = f"{type(failure).__name__}: {failure}"
        phase.seconds = time.monotonic() - started
        with lock:
            done.add(phase.name)
            if phase.error and failed is None:
                failed = phase
            print(
                f"{phase.name} {phase.seconds:.0f}s" + (" FAILED" if phase.error else ""),
                flush=True,
            )

    while True:
        with lock:
            if failed is not None:
                break
            ready = [
                phase
                for phase in by_name.values()
                if not phase.started and set(phase.needs) <= done
            ]
            for phase in ready:
                phase.started = True
            remaining = [phase for phase in by_name.values() if phase.name not in done]
        if not remaining:
            break
        for phase in ready:
            thread = threading.Thread(target=worker, args=(phase,), daemon=True)
            thread.start()
            threads.append(thread)
        time.sleep(0.05)

    for thread in threads:
        thread.join()
    with lock:
        if failed is None:
            for phase in by_name.values():
                if phase.error:
                    failed = phase
                    break
    return failed


# ##################################################################
# report failure
# print enough of the failing phase's log that the cause survives truncation
def report_failure(phase: Phase) -> None:
    print(f"--- {phase.name}: {phase.error} ---")
    if phase.log_path is None or not phase.log_path.exists():
        return
    lines = phase.log_path.read_text(errors="replace").splitlines()
    print(f"--- {phase.name}: first 80 lines ---")
    print("\n".join(lines[:80]))
    print(f"--- {phase.name}: last 200 lines ---")
    print("\n".join(lines[-200:]))
    failing = [line for line in lines if '"Action":"fail"' in line]
    if failing:
        print(f"--- {phase.name}: failing tests ---")
        print("\n".join(failing[:60]))


# ##################################################################
# sync gate venv
# the gate worktree venv is persistent and warm; reinstall requirements only
# when requirements.txt actually changed, so a new test dependency (e.g.
# pytest-xdist) can never make the gate fail on a stale venv
def sync_python_requirements() -> None:
    requirements = PROJECT_ROOT / "requirements.txt"
    if not requirements.is_file():
        return
    stamp = PROJECT_ROOT / ".venv" / ".gate-requirements-sha256"
    digest = hashlib.sha256(requirements.read_bytes()).hexdigest()
    if stamp.is_file() and stamp.read_text().strip() == digest:
        return
    started = time.monotonic()
    completed = subprocess.run(
        [str(PYTHON_BIN), "-m", "pip", "install", "-q", "-r", str(requirements)],
        capture_output=True,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise PhaseFailure(
            f"requirements sync failed: {completed.stdout}\n{completed.stderr}"
        )
    stamp.write_text(digest + "\n")
    print(f"python-requirements-sync {time.monotonic() - started:.0f}s", flush=True)


# ##################################################################
# main
# select, run, and report the release gate
def main() -> int:
    if not os.access(PYTHON_BIN, os.X_OK):
        print(f"release gate requires the repository venv at {PYTHON_BIN}", file=sys.stderr)
        return 1

    env = dict(os.environ)
    env["PATH"] = os.pathsep.join((*PATH_PREFIX, env.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin")))
    os.environ["PATH"] = env["PATH"]

    changed = _changed_paths()
    areas, reason = select_areas(changed)
    print(f"impact selection: {reason}", flush=True)

    work_root = Path(tempfile.mkdtemp(prefix="daz-agent-sdk-release."))
    started = time.monotonic()
    try:
        if "python" in areas:
            sync_python_requirements()
        phases = build_phases(areas, work_root, env)
        failed = run_phases(phases, work_root)
        if failed is not None:
            report_failure(failed)
            print(f"release gate FAILED in {time.monotonic() - started:.0f}s", file=sys.stderr)
            return 1
        print(f"release gate passed in {time.monotonic() - started:.0f}s")
        return 0
    except PhaseFailure as failure:
        print(str(failure), file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(work_root, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
