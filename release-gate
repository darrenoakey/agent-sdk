# ##################################################################
# phase
# one unit of validation: a command or callable plus its prerequisites
@dataclass
class Phase:
    name: str
    run: Callable[[Path], None]
    needs: tuple[str, ...] = ()
    seconds: float = 0.0
    error: str = ""
    started: bool = False
    log_path: Path | None = field(default=None, repr=False)


class PhaseFailure(RuntimeError):
    """A phase failed; the message is the operator-facing explanation."""


# ##################################################################
# command phase runner
# execute a subprocess, capture its output, raise with the log on failure
def _command(
    argv: Sequence[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    stdin_text: str | None = None,
) -> Callable[[Path], None]:
    def _run(log_path: Path) -> None:
        with log_path.open("wb") as log_file:
            keywords: dict[str, object] = {"stdin": subprocess.DEVNULL}
            if stdin_text is not None:
                keywords = {"input": stdin_text.encode()}
            completed = subprocess.run(
                list(argv),
                cwd=str(cwd or PROJECT_ROOT),
                env=env,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                check=False,
                **keywords,  # type: ignore[arg-type]
            )
        if completed.returncode != 0:
            raise PhaseFailure(f"exit {completed.returncode}")

    return _run


# ##################################################################
# shell phase runner
# same as _command but for the two checks that need shell semantics
def _shell(script: str, *, cwd: Path | None = None) -> Callable[[Path], None]:
    return _command(["/bin/sh", "-c", script], cwd=cwd)


# ##################################################################
# read changed paths
# ask git which repository paths this candidate actually touches
def _changed_paths() -> set[str] | None:
    def _git(*args: str) -> str | None:
        try:
            completed = subprocess.run(
                ["git", *args],
                cwd=str(PROJECT_ROOT),
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError:
            return None
        if completed.returncode != 0:
            return None
        return completed.stdout

    head_parent = _git("rev-parse", "--verify", "--quiet", "HEAD^")
    if not head_parent:
        return None
    diff = _git("diff", "--name-only", "HEAD^", "HEAD")
    if diff is None:
        return None
    status = _git("status", "--porcelain")
    if status is None:
        return None
    paths = {line.strip() for line in diff.splitlines() if line.strip()}
    for line in status.splitlines():
        entry = line[3:].strip()
        if not entry:
            continue
        # rename entries read "old -> new"; both sides count as touched.
        for part in entry.split(" -> "):
            cleaned = part.strip().strip('"')
            if cleaned:
                paths.add(cleaned)
    return paths


# ##################################################################
# impact selection
# map changed paths onto the validation areas they can break
def select_areas(changed: set[str] | None) -> tuple[set[str], str]:
    areas = {"scan"}
    if changed is None:
        return {"scan", "python", "go", "image"}, "full (diff unavailable)"
    if not changed:
        return {"scan", "python", "go", "image"}, "full (empty diff)"

    unattributed: list[str] = []
    for path in sorted(changed):
        if path.startswith("src/") or path in {
            "pyproject.toml",
            "requirements.txt",
            "run",
        }:
            areas.add("python")
            if path.startswith("src/daz_agent_sdk/capabilities/") or path in {
                "src/daz_agent_sdk/config.py",
                "pyproject.toml",
                "requirements.txt",
            }:
                areas.add("image")
        elif path.startswith("go/"):
            areas.add("go")
            if (
                path.startswith("go/capability/")
                or path.startswith("go/provider/")
                or path in {"go/go.mod", "go/go.sum", "go/config.go"}
            ):
                areas.add("image")
        elif path.startswith("docs/") or path.endswith(".md") or path in {
            "banner.jpg",
            ".gitignore",
        }:
            continue
        else:
            unattributed.append(path)

    if unattributed:
        # The gate script, greenline config, or anything else unmapped could
        # affect any area: validate everything rather than guess.
        return {"scan", "python", "go", "image"}, f"full (unmapped: {', '.join(unattributed[:4])})"
    if areas == {"scan"}:
        return areas, "documentation only"
    return areas, ", ".join(sorted(areas))


# ##################################################################
# pytest junit xml validation
# a green exit code is not enough: no skip, xfail, xpass, or empty suite
def validate_pytest_xml(xml_path: Path) -> None:
    def local_name(tag: str) -> str:
        return tag.rsplit("}", 1)[-1].lower()

    def count_attribute(element: ET.Element, name: str) -> int:
        value = element.attrib.get(name, "0")
        try:
            count = int(value)
        except ValueError as error:
            raise PhaseFailure(
                f"invalid pytest JUnit XML {name} count {value!r}"
            ) from error
        if count < 0:
            raise PhaseFailure(f"invalid pytest JUnit XML {name} count {count}")
        return count

    root = ET.parse(xml_path).getroot()
    suites = [element for element in root.iter() if local_name(element.tag) == "testsuite"]
    if not suites:
        raise PhaseFailure("pytest JUnit XML contains no testsuite")

    containers = [
        element
        for element in root.iter()
        if local_name(element.tag) in {"testsuite", "testsuites"}
    ]
    for suite in containers:
        for outcome in ("errors", "failures", "skipped"):
            count = count_attribute(suite, outcome)
            if count:
                raise PhaseFailure(f"pytest JUnit XML reports {count} {outcome}")
        for outcome in ("xfail", "xfails", "xfailed", "xpass", "xpasses", "xpassed"):
            if outcome in suite.attrib and count_attribute(suite, outcome):
                raise PhaseFailure(
                    f"pytest JUnit XML reports {suite.attrib[outcome]} {outcome}"
                )

    test_cases = [element for element in root.iter() if local_name(element.tag) == "testcase"]
    for test_case in test_cases:
        for child in test_case:
            outcome = local_name(child.tag)
            if outcome in {
                "error",
                "failure",
                "skipped",
                "xfail",
                "xfails",
                "xfailed",
                "xpass",
                "xpasses",
                "xpassed",
            }:
                raise PhaseFailure(f"pytest JUnit XML testcase reports {outcome}")
        represented = " ".join(
            test_case.attrib.get(name, "").lower() for name in ("status", "result", "outcome")
        )
        if any(outcome in represented for outcome in ("xfail", "xpass")):
            raise PhaseFailure("pytest JUnit XML testcase reports xfail/xpass")

    for element in root.iter():
        if local_name(element.tag) == "property":
            represented = " ".join(value.lower() for value in element.attrib.values())
            if any(outcome in represented for outcome in ("xfail", "xpass")):
                raise PhaseFailure("pytest JUnit XML property reports xfail/xpass")

    if test_cases:
        test_count = len(test_cases)
    else:
        top_suites = (
            [root]
            if local_name(root.tag) == "testsuite"
            else [element for element in root if local_name(element.tag) == "testsuite"]
        )
        test_count = sum(count_attribute(suite, "tests") for suite in top_suites)
    if test_count == 0:
        raise PhaseFailure("pytest JUnit XML reports zero tests")


# ##################################################################
# forbidden route scan
# the still-image route must stay closed in both language trees
def _route_scan(pattern: str, path: str, message: str) -> Callable[[Path], None]:
    def _run(log_path: Path) -> None:
        with log_path.open("wb") as log_file:
            completed = subprocess.run(
                ["rg", "-n", pattern, path],
                cwd=str(PROJECT_ROOT),
                stdout=log_file,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                check=False,
            )
        if completed.returncode == 0:
            raise PhaseFailure(message)
        if completed.returncode != 1:
            raise PhaseFailure(f"route scan failed: rg exit {completed.returncode}")

    return _run


# ##################################################################
# go skip scan
# a skipped Go test hides missing coverage; the JSON stream must have none
def _assert_no_go_skips(go_tests_log: Path) -> Callable[[Path], None]:
    def _run(_log_path: Path) -> None:
        text = go_tests_log.read_text(errors="replace")
        if '"Action":"skip"' in text:
            raise PhaseFailure("go release tests reported an unexpected skip")

    return _run


# ##################################################################
# remote go canary
# ship the prebuilt amd64 healthz binary to the Mac mini and run it there
def _remote_canary(binary_path: Path) -> Callable[[Path], None]:
    def _run(log_path: Path) -> None:
        ssh_base = [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            REMOTE_HOST,
        ]
        with log_path.open("w") as log_file:
            made = subprocess.run(
                [*ssh_base, "mktemp -d /tmp/daz-agent-sdk-go-canary.XXXXXX"],
                capture_output=True,
                text=True,
                stdin=subprocess.DEVNULL,
                check=False,
            )
            log_file.write(made.stdout + made.stderr)
            if made.returncode != 0:
                raise PhaseFailure(f"remote mktemp exit {made.returncode}")
            remote_root = made.stdout.splitlines()[0].strip() if made.stdout.strip() else ""
            if not remote_root.startswith("/tmp/daz-agent-sdk-go-canary."):
                raise PhaseFailure(
                    f"Mac mini returned an unsafe canary temporary path: {remote_root!r}"
                )
            try:
                copied = subprocess.run(
                    [
                        "scp",
                        "-q",
                        "-o",
                        "BatchMode=yes",
                        "-o",
                        "ConnectTimeout=10",
                        str(binary_path),
                        f"{REMOTE_HOST}:{remote_root}/igs-healthz.test",
                    ],
                    capture_output=True,
                    text=True,
                    stdin=subprocess.DEVNULL,
                    check=False,
                )
                log_file.write(copied.stdout + copied.stderr)
                if copied.returncode != 0:
                    raise PhaseFailure(f"scp of canary binary exit {copied.returncode}")
                ran = subprocess.run(
                    [
                        *ssh_base,
                        f"chmod +x {remote_root}/igs-healthz.test && "
                        f"{remote_root}/igs-healthz.test "
                        "-test.run '^TestImageServiceNativeTransportLive$' -test.count=1",
                    ],
                    capture_output=True,
                    text=True,
                    stdin=subprocess.DEVNULL,
                    check=False,
                )
                log_file.write(ran.stdout + ran.stderr)
                if ran.returncode != 0:
                    raise PhaseFailure(f"remote IGS healthz exit {ran.returncode}")
            finally:
                subprocess.run(
                    [*ssh_base, f"rm -rf -- {remote_root}"],
                    capture_output=True,
                    stdin=subprocess.DEVNULL,
                    check=False,
                )

    return _run


